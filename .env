# Global variables

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# адрес по которому токен сервер и агент будут обращаться к livekit(так как livekit запускается в docker-compose и он ожидает внутреннего доманного имени)
LIVEKIT_WS_URL=ws://livekit:7880


# Token server variables
# адрес который будет оттдан в браузер, соответственно запрос будет приходить извне
LIVEKIT_PUBLIC_WS_URL=ws://localhost:7880

# agent server variables
# прокси для yt-dlp/ffmpeg только если нужно
# AGENT_MEDIA_PROXY=http://ffcc962edbce:12334
AGENT_VIDEO_FPS=30

# frontend variables
VITE_TOKEN_ENDPOINT=http://localhost:4000/api/token