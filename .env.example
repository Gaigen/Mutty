# ============================================
# IMPORTANT: LIVEKIT keys must match in TWO places:
#   1. This file (LIVEKIT_API_KEY / LIVEKIT_API_SECRET)
#   2. livekit/livekit.prod.yaml (keys section)
# If they don't match — agent-server and token-server will get 401 errors.
# ============================================

# LiveKit credentials (must match livekit/livekit.prod.yaml keys section)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Docker internal address (livekit service name in docker-compose)
LIVEKIT_WS_URL=ws://livekit:7880

# Token server variables
# Address exposed to browser (must be accessible from user's machine)
LIVEKIT_PUBLIC_WS_URL=ws://localhost:7880

# CORS origins for token endpoint (comma-separated)
# Must include your frontend URL(s) — e.g. http://localhost:1420 or your domain
TOKEN_CORS_ORIGINS=http://localhost:1420

# Token validation limits
TOKEN_ROOM_MAX_LENGTH=100
TOKEN_IDENTITY_MAX_LENGTH=100
TOKEN_TTL=3600

# Optional: override LiveKit API URL (defaults to ws_url with ws→http)
# LIVEKIT_API_URL=http://livekit:7880

# Agent server variables
# Proxy for yt-dlp/ffmpeg (only if needed)
# AGENT_MEDIA_PROXY=http://proxy:port
AGENT_VIDEO_FPS=30

# Frontend variables
VITE_TOKEN_ENDPOINT=http://localhost:4000/api/token

# tldraw license (optional — get free Hobby key at https://tldraw.dev/r/pricing)
# Without a license, whiteboard works in evaluation mode (limited features after 30 days)
TLDRAW_LICENSE_KEY=

# OpenRouter (AI features) — optional
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=https://your-site.com
# OPENROUTER_SITE_NAME=Your Site
