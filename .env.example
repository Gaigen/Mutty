# ============================================
# IMPORTANT: LIVEKIT keys must match in TWO places:
#   1. This file (LIVEKIT_API_KEY / LIVEKIT_API_SECRET)
#   2. livekit/livekit.prod.yaml (keys section)
# If they don't match — agent-server and token-server will get 401 errors.
# ============================================

# LiveKit credentials (must match livekit/livekit.prod.yaml keys section)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=this-is-a-secret-key-for-local-dev-only

# Docker internal address (livekit service name in docker-compose)
LIVEKIT_WS_URL=ws://livekit:7880

# Token server variables
# Address exposed to browser (must be accessible from user's machine)
LIVEKIT_PUBLIC_WS_URL=ws://localhost:7880

# Agent server variables
# Proxy for yt-dlp/ffmpeg (only if needed)
# AGENT_MEDIA_PROXY=http://proxy:port
AGENT_VIDEO_FPS=30

# Frontend variables
VITE_TOKEN_ENDPOINT=http://localhost:4000/api/token
