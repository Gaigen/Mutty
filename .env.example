# ═══════════════════════════════════════════════════════════════════════════════
# ВАЖНО: В production ОБЯЗАТЕЛЬНО смените LIVEKIT_API_KEY и LIVEKIT_API_SECRET!
# devkey/secret — только для локальной разработки. См. livekit/*.yaml
# ═══════════════════════════════════════════════════════════════════════════════
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# URL для БРАУЗЕРА: домен/IP сервера (на сервере замени localhost на свой домен)
# При HTTPS используй wss:// и https://
VITE_LIVEKIT_URL=ws://localhost:7880
VITE_TOKEN_ENDPOINT=http://localhost:4000/api/token
VITE_AGENT_ENDPOINT=http://localhost:5000

# Agent API: если AGENT_API_KEY задан на сервере, задай тот же ключ во frontend
# VITE_AGENT_API_KEY=your-secret-api-key

# Разрешение видео-стрима (по умолчанию 1080p). Для экономии трафика: 1280x720
# AGENT_VIDEO_WIDTH=1920
# AGENT_VIDEO_HEIGHT=1080
# AGENT_VIDEO_FPS=30

# Token server: URL LiveKit в ответе клиенту (тот же домен, что и VITE_LIVEKIT_URL)
TOKEN_SERVER_PORT=4000
TOKEN_SERVER_HOST=0.0.0.0
LIVEKIT_WS_URL=ws://localhost:7880

# Token CORS: через запятую (пусто = *). В production укажи свои origins
# TOKEN_CORS_ORIGINS=https://myapp.com,https://www.myapp.com

# Token server: лимиты и TTL
# TOKEN_ROOM_MAX_LENGTH=100
# TOKEN_IDENTITY_MAX_LENGTH=100
# TOKEN_TTL=10m
